{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    /* `DOM` because this project covers `e2e/`, and a `page.evaluate` callback
       is serialised and run **inside the browser** — so `document` and
       `getComputedStyle` are legitimately in scope there even though nothing
       else this config compiles has a DOM. Without it the only way to write a
       computed-style assertion is a cast, which is exactly the escape hatch
       CONVENTIONS.md forbids. */
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "composite": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "isolatedModules": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e/**/*.ts", "src/api/paths.ts"]
}
