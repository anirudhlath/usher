# Usher's settings. `cp .env.example .env` and set USHER_SECRET_KEY; every other
# value is the setting's default, so a fresh copy changes nothing. Compose hands
# this whole file to the container, and its `environment:` overrides the five keys
# marked [compose-owned]. USHER_COMPOSE_* and COMPOSE_* keys are compose's alone and
# never reach the app; any other unknown USHER_* key fails startup, so a typo is loud.

# [compose-owned]: inside the stack the host is `postgres`, not `localhost`. This
# value is for a dev shell, `alembic` and the CLI.
USHER_DATABASE_URL=postgresql+asyncpg://usher:usher@localhost:5432/usher
# Connections kept open, and extra ones allowed under load. Every job in flight
# holds one, plus the claim, the heartbeat, and a bootstrap job's hold and reads,
# and `usher serve` runs the worker in the API's process: startup fails if
# USHER_JOB_CONCURRENCY + 4 exceeds the sum.
USHER_DB_POOL_SIZE=20
USHER_DB_MAX_OVERFLOW=10

# [compose-owned], both: the published port reaches nothing unless the app binds
# all interfaces, and 8000 is what compose's `ports:`, the Dockerfile's EXPOSE and
# the healthcheck assume. Live when you run `usher serve` yourself.
USHER_HOST=0.0.0.0
USHER_PORT=8000

USHER_LOG_LEVEL=INFO
USHER_LOG_JSON=true

# compose.yml only: the host port the container's 8000 is published on. Not a
# setting. 8100, so a host already using 8000 needs no edit.
USHER_COMPOSE_HOST_PORT=8100
# compose.yml only: the stack's network name. A second stack on one host changes
# it, its port above, and its project name, which compose reads from here too:
#   COMPOSE_PROJECT_NAME=usher-scratch
USHER_COMPOSE_NETWORK=usher_default
# Joining a shared telemetry stack's network is opt-in (docs/guide/configuration.md):
#   COMPOSE_FILE=compose.yml:compose.observability.yml

# Required, no default: encrypts stored source credentials, and both the app and
# `docker compose up` refuse to start without it. Generate with: openssl rand -hex 32
USHER_SECRET_KEY=

# Providers. A v3 API key or a v4 "API Read Access Token"; the v4 token is sent
# as a bearer header, which keeps it out of request URLs and so out of traces.
USHER_TMDB_API_KEY=
USHER_TMDB_BASE_URL=https://api.themoviedb.org/3
USHER_TMDB_REQUESTS_PER_SECOND=30
# Whose certification lands in Title.content_rating. ISO 3166-1 alpha-2.
USHER_TMDB_REGION=US
# Days a cached provider payload is reused before enrichment refetches it. At
# most 180, TMDb's own licensing term.
USHER_ENRICH_CACHE_MAX_AGE_DAYS=30

# Source adapters. Named source_*, not emby_*, so no setting is specific to one
# media server.
USHER_SOURCE_PAGE_SIZE=200
USHER_SOURCE_TIMEOUT_SECONDS=30
# Seconds a rejected credential is remembered before re-authenticating, so a
# wrong password does not turn every request into two.
USHER_SOURCE_REAUTH_COOLDOWN_SECONDS=60
# Calls per second to one source, spaced evenly; 0 is unlimited. One gate per
# source PER PROCESS, so a second container running `usher work` against the same
# server spends twice this. 0.4 never slows a sequential walk and does bind
# single-item reads.
USHER_SOURCE_REQUESTS_PER_SECOND=0.4

# The ingest pipeline and its job queue.
USHER_SYNC_BATCH_SIZE=1000
# The fraction of a source's items one reconcile may mark unavailable before it
# refuses and changes nothing. 1.0 disables the guard, which is what
# `usher sync --allow-full-retraction` passes on the command line.
USHER_SYNC_MAX_RETRACT_FRACTION=0.25
USHER_JOB_BATCH_SIZE=20
# After this many attempts a job is parked with its error, backing off
# exponentially (with jitter) from this base in between.
USHER_JOB_MAX_ATTEMPTS=5
USHER_JOB_BACKOFF_SECONDS=30
# Jobs one worker process runs at once; the per-kind ceilings under it are in
# `usher/services/jobs.py`. Every job in flight holds a database connection --
# see USHER_DB_POOL_SIZE.
USHER_JOB_CONCURRENCY=12
# How long a claim may go un-heartbeated before another worker may take it
# back. A bound on "the process stopped", not on how long a job may take: the
# worker touches everything in flight every third of this.
USHER_JOB_LEASE_SECONDS=300

# The push and worker lanes. Both on, so one image serves an all-in-one
# deployment; set USHER_WORKER_ENABLED=false in the server container and true in
# a second one to split them. A split-off worker's enrichments reach no SSE
# client (the bus is in-memory), so clients see them on their next refetch.
USHER_PUSH_ENABLED=true
USHER_WORKER_ENABLED=true
# Seconds a channel may deliver *nothing at all* before it is reconnected, and
# how long one recv waits before the watchdog ticks. Not a socket timeout:
# websockets' ping/pong catches a dead peer; this catches a silent live one.
USHER_PUSH_STALE_AFTER_SECONDS=90
USHER_PUSH_POLL_SECONDS=5
# Equal-jitter reconnect backoff, and the failure count after which the source is
# marked supports_push=false and left to the nightly walk.
USHER_PUSH_BACKOFF_SECONDS=5
USHER_PUSH_MAX_BACKOFF_SECONDS=300
USHER_PUSH_MAX_CONSECUTIVE_FAILURES=5
# How many items one push event may name before the lane asks for a delta
# walk instead of resolving them one request at a time. Capped at 500.
USHER_PUSH_MAX_ITEMS_PER_EVENT=50
# The minimum seconds between two gap-closing delta walks, and how often the
# source list is re-read, so a source added through the admin API gets a lane
# without a restart.
USHER_PUSH_GAP_MIN_INTERVAL_SECONDS=60
USHER_PUSH_SOURCE_REFRESH_SECONDS=60
# With no completed walk to resume from, a gap-closing delta reads the whole
# library, unprompted. cursored: refuse it and log a WARNING pointing at
# `usher sync`. always: walk anyway, still capped by USHER_PUSH_GAP_MAX_ITEMS.
# never: no gap-closing walk; what changed while the channel was down waits for
# your next `usher sync`, because the source does not re-deliver it.
USHER_PUSH_GAP_CLOSE=cursored
# Items one gap-closing delta may walk; 0 is unlimited, which `always` needs to
# reach a whole library. A walk stopped here records FAILED and advances no
# cursor, so nothing is skipped; `usher sync --kind full` closes the rest. Caps
# the item lane only; the watch lane keeps its own cursor.
USHER_PUSH_GAP_MAX_ITEMS=20000

# The scheduled-work lane, the only lane OFF by default. Enabled, it eventually
# starts a multi-hour neighbour rebuild you did not ask for, and nothing stops two
# runners: turn it on in exactly one process. `usher schedule --once` from your
# crontab is the alternative; it runs one tick, so each job's own period still
# decides what runs.
USHER_SCHEDULER_ENABLED=false
# Seconds between ticks. A tick is one query per registered job, and the floor
# of 60 keeps that negligible. A late tick delays a job by the same amount, since
# periods are hours.
USHER_SCHEDULER_TICK_SECONDS=300.0
# Days a `search_queries` row is kept. Minimum 1: zero is not a shorter retention
# but a cutoff at `now` that deletes every search's row as it is written. The
# prune runs once a day, only where the scheduler does (the lane above, or
# `usher schedule` from your crontab); that period is fixed, not a setting.
USHER_SEARCH_QUERY_RETENTION_DAYS=90
# Rows deleted per transaction. The prune commits per chunk so it never holds one
# long lock on a table every GET /search writes to. Minimum 1: at 0 the drain
# loop never ends.
USHER_SEARCH_QUERY_RETENTION_BATCH=10000
# Minimum hours from one completed `usher similar --rebuild` to the next. Keep it
# above your walk's duration (SELECT max(computed_at) - min(computed_at) FROM
# title_neighbors): at or below it the rebuild runs back to back forever. The job
# refuses, logging both names at ERROR, while USHER_EMBEDDING_MODEL disagrees with
# the model the stored vectors were written by.
USHER_SIMILAR_REBUILD_PERIOD_HOURS=24.0

# Seconds between keep-alive comments on an idle GET /events stream. Under 60:
# nginx closes an idle connection at 60 s and Cloudflare at ~100 s.
USHER_SSE_HEARTBEAT_SECONDS=20
# The replay ring for Last-Event-ID, and each subscriber's queue depth, in events.
# A client offline longer than the ring, or one that stops reading past the queue,
# is answered resync_required rather than replayed a partial stream.
USHER_SSE_BUFFER_SIZE=256
USHER_SSE_QUEUE_SIZE=64

# The semantic tier. Off by default: the runtime is an extra (`uv sync --extra
# embedding`) and full-text plus trigram need no model, so a deployment with this
# off is narrowed rather than broken; index jobs wait for a worker that has one.
USHER_EMBEDDING_ENABLED=false
# `fastembed:<checkpoint>` (in-process, needs the extra) or `openai:<checkpoint>`
# (POSTs to USHER_EMBEDDING_BASE_URL); any other prefix fails startup. Changing
# either half marks every stored vector stale for re-embedding. It must be
# 1024-dimensional. A fastembed checkpoint of another width is reported at
# startup and index jobs go unclaimed; an openai endpoint is checked on its first
# batch, which parks that index job. BAAI/bge-m3 is not in fastembed, so it needs
# `openai:`.
USHER_EMBEDDING_MODEL=fastembed:BAAI/bge-large-en-v1.5
# Read only by the openai runtime. Separate from USHER_LLM_BASE_URL because vLLM
# serves one model per process, so chat and embeddings are two servers.
USHER_EMBEDDING_BASE_URL=http://localhost:8001/v1
# Empty means no Authorization header at all, which is the local-server case.
USHER_EMBEDDING_API_KEY=
# Seconds for one whole batch, not one token. Bounded because a hung embedder
# holds a worker slot and the worker has no timeout of its own.
USHER_EMBEDDING_TIMEOUT_SECONDS=30.0
# Texts per batch. Best on CPU at 16; flat to 64, worse at 128.
USHER_EMBEDDING_BATCH_SIZE=16
# Sets HF_HUB_OFFLINE before the model library is imported. Leave it on: unset, a
# warm cache with no network fails with "Cannot send a request, as the client has
# been closed". Set false for the one run that warms the cache.
USHER_EMBEDDING_OFFLINE=true

# The most results a search may ask for, not its default: every candidate is a
# row assembled in application code, so an unclamped limit is a scan.
USHER_SEARCH_RESULT_LIMIT=50
# Reciprocal Rank Fusion's smoothing constant, 1/(k + rank); the RRF paper's
# value. Not the ranking blend's constant.
USHER_SEARCH_RRF_K=60
# pgvector's hnsw.ef_search, per statement: higher buys semantic recall with
# latency. pgvector's own 40 returns too few rows under a filter.
USHER_SEARCH_HNSW_EF_SEARCH=200
# pg_trgm's similarity() floor for type-ahead. Below ~0.3 the candidate cap
# starts truncating; above ~0.45 fuzzy recall is destroyed.
USHER_SEARCH_TRIGRAM_THRESHOLD=0.3
# Trigram candidates collected before the levenshtein re-rank. Must exceed
# USHER_SEARCH_RESULT_LIMIT or the re-rank can only reorder what the cap chose.
USHER_SEARCH_SUGGEST_CANDIDATES=200
# Whether type-ahead writes a search_queries row per answered keystroke. The
# write is buffered, so the request pays only an append. Whole or nothing, never
# a sample rate, because the analytics are counts. GET /search records either way.
USHER_SEARCH_SUGGEST_ANALYTICS=true

# The LLM, for curated rows and query expansion. Off by default: nine of ten row
# providers need no model, and "on" sends the household's watch history to a
# machine the household may not own. On alone buys curation, one completion per
# household per generation. Every call lands in `llm_calls`.
USHER_LLM_ENABLED=false
# Any OpenAI-compatible endpoint: a local vLLM or Ollama, OpenRouter, OpenAI,
# Groq, Together.
USHER_LLM_BASE_URL=http://localhost:8000/v1
# Blank is a real value -- a local vLLM or Ollama needs no credential.
USHER_LLM_API_KEY=
USHER_LLM_MODEL=gpt-4o-mini
# A correctness setting rather than a cost one: a completion that hits the
# ceiling under guided decoding comes back as *valid* JSON with rows missing
# off the end, so the adapter refuses a truncated answer outright.
USHER_LLM_MAX_OUTPUT_TOKENS=2048
USHER_LLM_TIMEOUT_SECONDS=120
# Dollars per million tokens, because no provider reports cost. 0 is right for a
# local model; set both for a hosted one or the cost dashboard reads zero. Token
# counts are recorded either way, so spend stays recomputable.
USHER_LLM_PRICE_IN_PER_MTOK=0
USHER_LLM_PRICE_OUT_PER_MTOK=0

# Candidate titles one curation prompt carries (~15 prompt tokens each), so really
# a statement about your model's context window: lower it if a generation parks
# with a context-length error.
USHER_CURATION_POOL_SIZE=200

# One completion rewriting a query before a semantic or fused search embeds it.
# Off even with the LLM on, because it made retrieval worse on this project's own
# evaluation; `llm_calls` grouped by purpose is what it costs. Needs
# USHER_LLM_ENABLED=true or startup fails. `usher search --mode full_text` and
# type-ahead embed nothing, so it does nothing for them.
USHER_QUERY_EXPANSION_ENABLED=false

# The image proxy (GET /images/{id}). The width ladder is a constant in
# src/usher/ports/images.py, not a setting, because it is what bounds the cache.
# [compose-owned]: the container's cache is /data/images, bind-mounted from
# ./data/images. This relative value is for a dev shell; never commit the cache.
USHER_IMAGE_CACHE_DIR=data/images
# Bytes one upstream image may be, refused while it streams rather than trusting
# Content-Length. 5 MiB is above anything the ladder can request.
USHER_IMAGE_MAX_BYTES=5242880
# Seconds one cold image may take. Far below the LLM's 120, because a request is
# waiting on it.
USHER_IMAGE_FETCH_TIMEOUT_SECONDS=10
# The provider's image host, {base} in the ladder's {base}{rung}{path}: a constant
# rather than a lookup per cold image. Point it at a caching proxy if your network
# needs one; it takes no credential.
USHER_IMAGE_CDN_BASE_URL=https://image.tmdb.org/t/p/

# Telemetry (optional — when unset, no exporter is constructed at all)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=usher

# Bulk bootstrap. [compose-owned]: the container's cache is /data/bulk. This
# relative value is for a dev shell, inside .gitignore's data/ -- never commit a
# dataset file.
USHER_BULK_DATA_DIR=data/bulk
USHER_BULK_BATCH_SIZE=50000
USHER_WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql
# WDQS requires a descriptive User-Agent naming the tool and a contact.
USHER_BULK_USER_AGENT=Usher/0.1 (+https://github.com/anirudhlath/usher)

# The web console, served by this process at /console. Off suits a worker-only or
# push-only container, or a household running its own client.
USHER_CONSOLE_ENABLED=true
# Where the built bundle lives, relative to the working directory; the same value
# in a checkout and in the image. A missing bundle is logged once and the API
# serves alone.
USHER_CONSOLE_DIST_DIR=web/dist
# The deployment's Grafana and Tempo, for the console's "Open in Grafana" and
# "Open trace" links. Unset, each is absent rather than a dead link. Neither is
# proxied; the browser follows them directly.
USHER_GRAFANA_URL=
USHER_TEMPO_URL=
