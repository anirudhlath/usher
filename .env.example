# Usher's configuration, and the file compose reads.
#
# `cp .env.example .env`, fill in USHER_SECRET_KEY, and you have both halves:
# compose hands this whole file to the usher container (`env_file:`), so
# every USHER_*/OTEL_* key below is a live control. The four compose sets
# itself are marked [compose-owned] -- they belong to the container topology
# rather than to you, and `environment:` overrides whatever is here.
#
# Every value below is the setting's own default (pinned by
# tests/unit/test_deployment_config.py), so a fresh copy changes nothing.
#
# USHER_COMPOSE_* is the one reserved namespace: those keys are compose's
# alone and the application deliberately ignores them. Any other unknown
# USHER_* key is refused at startup rather than ignored, so a typo is loud.

# Database. [compose-owned] -- inside the stack the host is `postgres`, not
# `localhost`; this value is for a dev shell, `alembic`, and the CLI.
USHER_DATABASE_URL=postgresql+asyncpg://usher:usher@localhost:5432/usher
# The connection pool. Sized against USHER_JOB_CONCURRENCY: every job in
# flight holds a session, plus one for the claim and one for the heartbeat,
# and `usher serve` runs the worker lane in the same process as the API. The
# app refuses to start if the concurrency cannot fit.
USHER_DB_POOL_SIZE=20
USHER_DB_MAX_OVERFLOW=10

# Server. Both [compose-owned]: the published port reaches nothing unless the
# app binds all interfaces, and 8000 is what compose's `ports:`, the
# Dockerfile's EXPOSE and the container healthcheck all assume. Live when you
# run `usher serve` yourself.
USHER_HOST=0.0.0.0
USHER_PORT=8000

USHER_LOG_LEVEL=INFO
USHER_LOG_JSON=true

# compose.yml only -- the *host*-side port the usher container's 8000 is
# published on. Not a setting: compose substitutes it directly into the
# "ports:" mapping, and USHER_COMPOSE_ is the namespace the application
# ignores for exactly this. Defaults to 8100 so it doesn't assume host port
# 8000 is free (it may well not be -- that's the whole reason this knob
# exists rather than a hardcoded "8000:8000").
USHER_COMPOSE_HOST_PORT=8100

# Secrets (required; used to encrypt source credentials — no default, startup
# fails without it). Generate with: openssl rand -hex 32
USHER_SECRET_KEY=

# Providers. The key may be either a classic v3 API key or a v4 "API Read
# Access Token" -- the adapter sends the second as a bearer header, which
# keeps the credential out of request URLs (and therefore out of traces).
USHER_TMDB_API_KEY=
USHER_TMDB_BASE_URL=https://api.themoviedb.org/3
USHER_TMDB_REQUESTS_PER_SECOND=30
# Whose certification lands in Title.content_rating. ISO 3166-1 alpha-2.
USHER_TMDB_REGION=US
# How long a cached provider payload is reused before the enrich stage
# refetches. Capped at 180 days by TMDb's own licensing term.
USHER_ENRICH_CACHE_MAX_AGE_DAYS=30

# Source adapters (PRD 03). Named source_* rather than emby_* deliberately:
# a setting named for one media server would be the first source-specific
# concept to escape adapters/.
USHER_SOURCE_PAGE_SIZE=200
USHER_SOURCE_TIMEOUT_SECONDS=30
# How long a rejected credential is remembered before another authentication
# is attempted, so a wrong password does not turn every request into two.
USHER_SOURCE_REAUTH_COOLDOWN_SECONDS=60

# The ingest pipeline (PRD 03) and its job queue (PRD 08).
USHER_SYNC_BATCH_SIZE=1000
# The fraction of a source's items one reconcile may mark unavailable before
# it refuses and changes nothing (ADR-0015). 1.0 disables the guard, which is
# what `usher sync --allow-full-retraction` passes on the command line.
USHER_SYNC_MAX_RETRACT_FRACTION=0.25
USHER_JOB_BATCH_SIZE=20
# After this many attempts a job is parked with its error, backing off
# exponentially (with jitter) from this base in between.
USHER_JOB_MAX_ATTEMPTS=5
USHER_JOB_BACKOFF_SECONDS=30
# How many jobs one worker process runs at once. 12 is Little's law over M9's
# measured TMDb tail (p95 0.4267 s of HTTP plus ~0.033 s of bookkeeping, so
# ~11.5 in flight to hold ADR-0005's ~25 rps); the per-kind ceilings under it
# are in `usher/services/jobs.py` and each names its own measurement.
# Every job in flight holds a database connection -- see USHER_DB_POOL_SIZE.
USHER_JOB_CONCURRENCY=12
# How long a claim may go un-heartbeated before another worker may take it
# back. A bound on "the process stopped", not on how long a job may take: the
# worker touches everything in flight every third of this.
USHER_JOB_LEASE_SECONDS=300

# The push lane and the worker lane (PRD 03; PRD 01's concurrency model).
# Both switches default on, so one image serves an all-in-one deployment;
# set USHER_WORKER_ENABLED=false in the server container and true in a
# second one to split the lanes with no code change. With the worker in a
# separate process an enrichment it finishes reaches no SSE client -- the
# bus is in-memory -- so a client that refetches still gets the enriched
# title, which is degradation rather than breakage.
USHER_PUSH_ENABLED=true
USHER_WORKER_ENABLED=true
# How long a channel may deliver *nothing at all* before it is torn down
# and reconnected, and how long one recv waits before the watchdog ticks.
# Not a socket timeout -- websockets' own ping/pong already detects a dead
# TCP peer; this detects a live one that has stopped delivering.
USHER_PUSH_STALE_AFTER_SECONDS=90
USHER_PUSH_POLL_SECONDS=5
# Equal-jitter reconnect backoff, and the ceiling after which the source is
# marked supports_push=false and left to the nightly walk.
USHER_PUSH_BACKOFF_SECONDS=5
USHER_PUSH_MAX_BACKOFF_SECONDS=300
USHER_PUSH_MAX_CONSECUTIVE_FAILURES=5
# How many items one push event may name before the lane asks for a delta
# walk instead of resolving them one request at a time. Capped at 500.
USHER_PUSH_MAX_ITEMS_PER_EVENT=50
# The floor between two gap-closing delta walks, and how often the lane set
# is re-read so a source added through the admin API gets a lane without a
# restart.
USHER_PUSH_GAP_MIN_INTERVAL_SECONDS=60
USHER_PUSH_SOURCE_REFRESH_SECONDS=60

# The client event channel (PRD 07's GET /events). A comment line every this
# many seconds on an otherwise idle stream: nginx closes an idle connection
# at 60 s and Cloudflare at ~100 s, so anything at or above 60 drops on
# every proxied deployment.
USHER_SSE_HEARTBEAT_SECONDS=20
# The replay ring for Last-Event-ID, and each subscriber's queue depth. A
# client offline for longer than the ring, or one that stops reading past the
# queue, is answered resync_required rather than replayed a partial stream.
USHER_SSE_BUFFER_SIZE=256
USHER_SSE_QUEUE_SIZE=64

# The embedding model (PRD 05's semantic tier, M6). Off by default: the
# dependency lives behind an extra (`uv sync --extra embedding`), and
# full-text plus trigram over all 1.27M titles needs no model at all, so a
# deployment with this off is narrowed rather than broken -- it simply leaves
# index jobs for a worker that has one.
USHER_EMBEDDING_ENABLED=false
# The runtime *and* the checkpoint. Written to title_embeddings.model_name,
# so changing it invalidates every stored vector through the stale predicate
# and the backfill re-embeds -- no migration, PROVIDED the width does not
# change. The two are not separable: the same weights under
# sentence-transformers and fastembed differ by 6x the halfvec quantisation
# error.
#
# Two runtimes, and the prefix picks one:
#
#   fastembed:<checkpoint>   loaded in-process, needs `uv sync --extra
#                            embedding`, no server
#   openai:<checkpoint>      POST {USHER_EMBEDDING_BASE_URL}/embeddings on any
#                            OpenAI-compatible server
#
# An unrecognised prefix is a startup error rather than a fallback: a typo
# that fell back would embed the catalog with one model and record the name of
# another, and the fingerprint is trusted everywhere else.
#
# **Whatever you pick must be 1024-dimensional.** Migration m09e widened
# title_embeddings.embedding and user_taste.centroid to halfvec(1024) for
# BAAI/bge-m3; the width is deployment-wide, so a 384-wide checkpoint such as
# bge-small-en-v1.5 can no longer be stored. A mismatch is reported once at
# startup and index jobs go unclaimed -- it does not corrupt anything.
#
# bge-m3 is not available through fastembed at all (checked across all five of
# its model classes on 2026-08-13), which is why the openai runtime exists.
USHER_EMBEDDING_MODEL=fastembed:BAAI/bge-large-en-v1.5
# Read only by the openai runtime. Deliberately a separate setting from
# USHER_LLM_BASE_URL: vLLM serves one model per process, so a host running
# both a chat model and an embedding model runs two of them on two ports.
USHER_EMBEDDING_BASE_URL=http://localhost:8001/v1
# Empty means no Authorization header at all, which is the local-server case.
USHER_EMBEDDING_API_KEY=
# One whole batch, not one token. Bounded because an embedder that hangs holds
# a worker slot and JobWorker has no timeout of its own.
USHER_EMBEDDING_TIMEOUT_SECONDS=30.0
# Measured best on CPU at 16; flat from 16 to 64, worse at 128.
USHER_EMBEDDING_BATCH_SIZE=16
# Sets HF_HUB_OFFLINE before the model library is imported. Leave it on: with
# a warm cache and no network, unset, the load fails with "Cannot send a
# request, as the client has been closed" -- a message naming neither the
# network nor the cache. Set false for the one run that warms the cache.
USHER_EMBEDDING_OFFLINE=true

# Retrieval (PRD 05, M6). The most a search may ask for, not its default --
# every candidate becomes a row assembled in application code, so an unclamped
# limit is a scan wearing a search's name.
USHER_SEARCH_RESULT_LIMIT=50
# Reciprocal Rank Fusion's smoothing constant, 1/(k + rank). RRF's original
# paper's value, and ADR-0002's assumption. Not the constant the ranking blend
# uses -- that one is 1, because it scales against a popularity term rather
# than against a second candidate list.
USHER_SEARCH_RRF_K=60
# pgvector's hnsw.ef_search, per statement. The GUC's own default of 40
# returned 0.88 rows of a requested 10 under a filter, measured.
USHER_SEARCH_HNSW_EF_SEARCH=100
# pg_trgm's similarity() floor for type-ahead. Below ~0.3 the candidate cap
# starts truncating; above ~0.45 fuzzy recall is destroyed.
USHER_SEARCH_TRIGRAM_THRESHOLD=0.3
# Trigram candidates collected before the levenshtein re-rank. Must exceed
# USHER_SEARCH_RESULT_LIMIT or the re-rank can only reorder what the cap
# already chose.
USHER_SEARCH_SUGGEST_CANDIDATES=200

# The LLM (PRD 06's curated rows, PRD 05's query expansion). Off by default,
# and that is the honest default twice over: nine of ten row providers need no
# model, so a deployment without one gets a shorter home screen rather than a
# broken one -- and this is the only setting here whose "on" state sends the
# household's watch history to a machine the household may not own.
#
# Two spenders and two switches. This one is the client: with it false there
# is no LLM in the process at all. On its own it buys curation -- one
# completion per household per generation. Query expansion is the second
# switch, further down, and is off even when this is on. Every attempt of
# either lands in `llm_calls`, so what it actually cost is one SELECT away.
USHER_LLM_ENABLED=false
# The whole of the provider abstraction (ADR-0027). Any OpenAI-compatible
# endpoint: a local vLLM or Ollama, OpenRouter, OpenAI, Groq, Together. The
# default is localhost because this project's reference deployment is
# self-hosted.
USHER_LLM_BASE_URL=http://localhost:8000/v1
# Blank is a real value -- a local vLLM or Ollama needs no credential.
USHER_LLM_API_KEY=
USHER_LLM_MODEL=gpt-4o-mini
# A correctness setting rather than a cost one: a completion that hits the
# ceiling under guided decoding comes back as *valid* JSON with rows missing
# off the end, so the adapter refuses a truncated answer outright.
USHER_LLM_MAX_OUTPUT_TOKENS=2048
USHER_LLM_TIMEOUT_SECONDS=120
# Dollars per million tokens, because no provider reports cost -- the usage
# object carries token counts and nothing else. Leave at 0 for a local model,
# which is the honest value; set them for a hosted one or the cost dashboard
# reads zero. Token counts are recorded exactly either way, so spend stays
# recomputable from the ledger afterwards.
USHER_LLM_PRICE_IN_PER_MTOK=0
USHER_LLM_PRICE_OUT_PER_MTOK=0

# LLM curation. How many candidate titles one generation's prompt carries,
# addressed by index. Measured: at 200 the pool costs ~2,924 prompt tokens
# (~14.6 a candidate), so this is really a statement about the context window
# of whatever model USHER_LLM_BASE_URL serves -- raise it for a large hosted
# model, lower it if a generation parks with a context-length error.
USHER_CURATION_POOL_SIZE=200

# LLM query expansion: one completion rewriting the query before a semantic or
# fused search embeds it. Off by default even with USHER_LLM_ENABLED=true, and
# that default is a measurement rather than caution -- run on 2026-08-07
# against a local gemma-4-26b-a4b over five mood queries and 150 real
# overviews, it made retrieval worse (MRR 0.733 -> 0.373, recall@10
# 0.800 -> 0.533), because the rewrites drift toward generic critic prose that
# sits near the middle of the corpus. Turn it on to try it against your own
# model; `llm_calls` grouped by purpose is what it cost.
#
# Setting this true with USHER_LLM_ENABLED=false is refused at startup rather
# than ignored: with no client there is no completion to put in front of the
# embed, so it would be a knob that does nothing.
#
# Two things buy nothing either way: `usher search --mode full_text` (no embed
# to sit in front of) and `usher suggest` (type-ahead has no semantic lane,
# which is what keeps this off the per-keystroke path).
USHER_QUERY_EXPANSION_ENABLED=false

# The image proxy (PRD 07's GET /images/{id}). Four settings, and the width
# ladder is deliberately not one of them: (154, 342, 780, 1280) is a tuple in
# src/usher/ports/images.py, because it is what bounds the cache and a knob
# nothing reads is dead config wearing a control's name (ADR-0032).
#
# Where the cached bytes live. [compose-owned] -- the container's is
# /data/images, which compose bind-mounts from ./data/images on the host, and
# a relative path inside a container whose WORKDIR is /app would put the cache
# in the image. This value is for a dev shell. Inside .gitignore's data/,
# beside USHER_BULK_DATA_DIR; never commit one.
USHER_IMAGE_CACHE_DIR=data/images
# The most one CDN answer may be, refused while it streams rather than against
# a Content-Length the sender controls. 5 MiB is above every byte this proxy
# can legitimately receive: the largest artwork ADR-0032 measured anywhere is
# 4,731,805 bytes and that is an "original", which the ladder cannot express
# and the fetcher never requests. The largest rung measured is a 563 KB
# median poster at w1280.
USHER_IMAGE_MAX_BYTES=5242880
# How long one cold image may take. Two orders below the LLM's 120 because
# the lane decides it, not the upstream: a curation completion is a worker job
# and this is a request with somebody waiting on it.
USHER_IMAGE_FETCH_TIMEOUT_SECONDS=10
# The provider's image host -- {base} in the ladder's {base}{rung}{path}. A
# configured constant rather than a /configuration call per cold image: that
# would be a second network round trip, against an authenticated endpoint, for
# a value that changes approximately never. Read live from it on 2026-08-11.
# Point it at a caching proxy if your network needs one; it takes no
# credential and the CDN wants none.
USHER_IMAGE_CDN_BASE_URL=https://image.tmdb.org/t/p/

# Telemetry (optional — when unset, no exporter is constructed at all)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=usher

# Bulk bootstrap (PRD 04 Phases 0-2). Downloaded dumps land in
# USHER_BULK_DATA_DIR, which is inside .gitignore's data/ -- never commit a
# dataset file.
USHER_BULK_DATA_DIR=data/bulk
USHER_BULK_BATCH_SIZE=50000
USHER_WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql
# WDQS requires a descriptive User-Agent naming the tool and a contact.
USHER_BULK_USER_AGENT=Usher/0.1 (+https://github.com/anirudhlath/usher)
